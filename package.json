{
  "name": "aurora-launcher",
  "version": "2.0.1",
  "author": "Morbryn",
  "description": "Aurora Launcher - Modern custom Minecraft Launcher",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "npm run compile:electron && electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && set VITE_DEV_SERVER_URL=http://localhost:5173&& npm run dev:electron\"",
    "compile:electron": "tsc --project tsconfig.electron.json && node scripts/copy-icons.js",
    "build:renderer": "vite build",
    "build": "npm run compile:electron && npm run build:renderer",
    "package": "npm run build && electron-builder",
    "package:win": "node scripts/package.js",
    "lint": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.electron.json"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.294.0",
    "node-fetch": "^2.7.0",
    "prismarine-nbt": "^2.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.6.9",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "sharp": "^0.34.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.auroralauncher.app",
    "productName": "Aurora Launcher",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "Aurora Launcher.${ext}"
    },
    "nsis": {
      "artifactName": "Aurora Launcher Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Deathgasm23",
      "repo": "aurora-launcher",
      "private": false
    }
  }
}
