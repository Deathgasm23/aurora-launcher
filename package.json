{
  "name": "aurora-launcher",
  "version": "1.2.2",
  "author": "Morbryn",
  "description": "Aurora Launcher - Modern custom Minecraft Launcher",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "npm run compile:electron && electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && set VITE_DEV_SERVER_URL=http://localhost:5173&& npm run dev:electron\"",
    "compile:electron": "tsc --project tsconfig.electron.json && node scripts/copy-icons.js",
    "build:renderer": "vite build",
    "build": "npm run compile:electron && npm run build:renderer",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win && node scripts/clean-release.js",
    "package:linux": "npm run build && electron-builder --linux && node scripts/clean-release.js",
    "package:mac": "npm run build && electron-builder --mac && node scripts/clean-release.js",
    "lint": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.electron.json"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.294.0",
    "node-fetch": "^2.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.6.9",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.auroralauncher.app",
    "productName": "Aurora Launcher",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Deathgasm23",
      "repo": "aurora-launcher",
      "private": false
    }
  }
}
